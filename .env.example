# ============================================================================
# COMMON SETTINGS
# ============================================================================
NODE_ENV=development

# ============================================================================
# POSTGRES DATABASE
# ============================================================================
POSTGRES_DB=corely
POSTGRES_USER=corely
POSTGRES_PASSWORD=corely
DATABASE_URL=postgresql://corely:corely@postgres:5432/corely?schema=public

# ============================================================================
# REDIS CACHE & QUEUE
# ============================================================================
REDIS_URL=redis://redis:6379
# Queue driver: bullmq | memory | cloudtasks
WORKFLOW_QUEUE_DRIVER=bullmq
# Optional shared secret for Cloud Tasks HTTP delivery
WORKFLOW_QUEUE_SECRET=

# Cloud Tasks (used when WORKFLOW_QUEUE_DRIVER=cloudtasks)
WORKFLOW_CLOUDTASKS_LOCATION=
WORKFLOW_CLOUDTASKS_QUEUE_PREFIX=
WORKFLOW_CLOUDTASKS_TARGET_BASE_URL=
WORKFLOW_CLOUDTASKS_SERVICE_ACCOUNT=

# ============================================================================
# FRONTEND (VITE)
# ============================================================================
# For DEMO profile (uses mock-server):
# VITE_API_BASE_URL=http://localhost:4000
# For FULL profile (uses real API):
# VITE_API_BASE_URL=http://localhost:3000

# Default to real API; set VITE_API_MODE=mock to point to mock server
VITE_API_BASE_URL=http://localhost:3000
VITE_API_MODE=real
# Public web app base URL (used for "View Listing" links in admin)
VITE_PUBLIC_WEB_BASE_URL=http://localhost:3001
# Website runtime app base URL (used for website page preview/public website links)
VITE_WEBSITE_RUNTIME_BASE_URL=http://localhost:8084
# Next/public runtime API base URL (used by apps/public-web and apps/website-runtime)
CORELY_API_BASE_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Root workspace domain for host-based routing (workspace.my.corely.one)
NEXT_PUBLIC_ROOT_DOMAIN=my.corely.one

# ============================================================================
# PORTS
# ============================================================================
WEB_PORT=8080
PORT=3000
MOCK_PORT=4000
WORKER_PORT=3001

# ============================================================================
# WORKER
# ============================================================================
# Base URL worker uses when calling API endpoints (invoice reminders, billing, etc.)
API_BASE_URL=http://localhost:3000

# ============================================================================
# SECURITY & AUTH
# ============================================================================
JWT_SECRET=dev-jwt-secret-change-me-in-production
# Optional but recommended for integrations secret encryption (falls back to JWT_SECRET).
INTEGRATIONS_SECRET_KEY=dev-integrations-secret-change-me
WEB_BASE_URL=http://localhost:8080
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# ============================================================================
# TRUSTED SURFACE PROXY KEYS
# ============================================================================
# Vercel surface projects should set one unique secret per surface and inject it
# on proxied /api/* requests via x-corely-proxy-key.
CORELY_PROXY_KEY_APP=
CORELY_PROXY_KEY_POS=
CORELY_PROXY_KEY_CRM=

# Local surface hostnames for manual browser testing.
# Add app.localhost / pos.localhost / crm.localhost to /etc/hosts if needed.
# When proxying /api/* locally, inject the matching CORELY_PROXY_KEY_* header.
CORELY_LOCAL_APP_URL=http://app.localhost:8080
CORELY_LOCAL_POS_URL=http://pos.localhost:8080
CORELY_LOCAL_CRM_URL=http://crm.localhost:8080
CORELY_RESTAURANT_DEMO_EMAIL=demo.restaurant@corely.local
CORELY_RESTAURANT_DEMO_PASSWORD=Password123!

# ============================================================================
# PUBLIC WORKSPACE HOST RESOLUTION
# ============================================================================
# Preferred: comma-separated list of allowed public workspace base domains.
# Example production value:
# PUBLIC_WORKSPACE_BASE_DOMAINS=portal.corely.one,my.corely.one
PUBLIC_WORKSPACE_BASE_DOMAINS=

# ============================================================================
# PUBLIC DIRECTORY (BERLIN LISTING)
# ============================================================================
# If unset, API defaults to directory-public-tenant / directory-public-workspace
DIRECTORY_PUBLIC_TENANT_ID=directory-public-tenant
DIRECTORY_PUBLIC_WORKSPACE_ID=directory-public-workspace
# Optional worker notification mailbox for new directory leads
DIRECTORY_LEADS_NOTIFY_EMAIL=

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=debug

# ============================================================================
# AI PROVIDERS
# ============================================================================
# Set provider: openai | anthropic
AI_MODEL_PROVIDER=openai
# Default model IDs (override per env if needed)
AI_MODEL_ID=gpt-5-mini
# OpenAI API key
OPENAI_API_KEY=
# Anthropic API key
ANTHROPIC_API_KEY=
# Speech-to-text provider: openai | google | none
SPEECH_TO_TEXT_PROVIDER=
# CRM AI feature flags
CRM_AI_ENABLED=false
CRM_AI_V2_ANALYTICS_ENABLED=false
CRM_AI_INTENT_SENTIMENT_ENABLED=false
# Example Anthropic setup:
# AI_MODEL_PROVIDER=anthropic
# AI_MODEL_ID=claude-3-5-sonnet-20240620
# ANTHROPIC_API_KEY=sk-ant-...

# ============================================================================
# EMAIL PROVIDERS
# ============================================================================
# Select provider: resend | sendgrid | ses | postmark (only resend implemented)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM="Corely Billing <billing@example.com>"
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=

# ============================================================================
# BILLING (STRIPE)
# ============================================================================
# Stripe provider credentials
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Corely plan price IDs in Stripe
STRIPE_BILLING_PRICE_STARTER_MONTHLY=
STRIPE_BILLING_PRICE_PRO_MONTHLY=
STRIPE_BILLING_PRICE_MULTI_LOCATION_MONTHLY=
# Hosted billing flow return URLs
STRIPE_BILLING_SUCCESS_URL=http://localhost:8088/settings/billing?checkout=success
STRIPE_BILLING_CANCEL_URL=http://localhost:8088/settings/billing?checkout=cancelled
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:8088/settings/billing

# ============================================================================
# OBJECT STORAGE (GCS default)
# ============================================================================
STORAGE_PROVIDER=gcs
STORAGE_BUCKET=uploads
STORAGE_KEY_PREFIX=env/dev
SIGNED_URL_UPLOAD_TTL_SECONDS=600
SIGNED_URL_DOWNLOAD_TTL_SECONDS=600
MAX_UPLOAD_BYTES=52428800
# Optional Google credentials
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================================================
# OBSERVABILITY (Langfuse/OTLP)
# ============================================================================
# Options: none | otel | langfuse
OBSERVABILITY_PROVIDER=none
# Sampling ratio 0-1 (use 1 for dev/staging)
OBSERVABILITY_SAMPLE_RATIO=1
# Masking: off | standard | strict
OBSERVABILITY_MASKING_MODE=standard
# OTLP endpoint (Langfuse Cloud: https://cloud.langfuse.com/otlp)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional extra headers (key=value comma-separated) if not using Langfuse basic auth
OTEL_EXPORTER_OTLP_HEADERS=
# Langfuse auth (used when provider=langfuse)
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ============================================================================
# ANALYTICS (PostHog)
# ============================================================================
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

VITE_PORTAL_API_BASE_URL
PUBLIC_WORKSPACE_QUERY_ENABLED

WORKER_TICK_RUNNERS=outbox,classesBilling
WORKER_BUSY_LOOP_DELAY_MS=3000

# ============================================================================
# E2E TESTING (Local Development)
# ============================================================================
E2E_DATABASE_ADMIN_URL=postgresql://corely:corely@localhost:5433/postgres?schema=public
E2E_DATABASE_URL=postgresql://corely:corely@localhost:5433/corely_cash_e2e?schema=public
E2E_WEB_PORT=3100
E2E_API_PORT=3101
E2E_BASE_URL=http://localhost:3100
E2E_API_URL=http://localhost:3101
E2E_TIMEZONE=Europe/Berlin
E2E_ADMIN_AUTH_SUB=local|corely-cash-e2e-admin
E2E_AUTH_SECRET=local-e2e-secret-key-change-me
E2E_TENANT_SLUG=corely-cash-e2e
E2E_LOCATION_SLUG=berlin-nail-salon-e2e
E2E_REGISTER_CODE=E2E-KASSE-01
ENABLE_E2E_AUTH=true
E2E_AI_PROVIDER=deterministic

