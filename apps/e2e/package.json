{
  "name": "@corely/e2e",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:pos": "playwright test --config playwright.pos.config.ts",
    "e2e:cash-dashboard": "playwright test --config playwright.cash.config.ts tests/cash-management/cash-dashboard.e2e.spec.ts",
    "e2e:billing": "playwright test --config playwright.cash.config.ts tests/cash-management/billing-subscriptions.e2e.spec.ts",
    "e2e:billing:stripe": "playwright test --config playwright.cash.config.ts tests/cash-management/billing-subscriptions.stripe.e2e.spec.ts",
    "e2e:pos:screens": "POS_CAPTURE_SCREENS=true playwright test --config playwright.pos.config.ts tests/pos/pos.screenshots.spec.ts",
    "e2e:cash:screens": "CASH_CAPTURE_SCREENS=true playwright test tests/cash-management/cash-management-screenshots.e2e.spec.ts --project=chromium",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:debug": "playwright test --debug",
    "e2e:cash:test": "playwright test --config playwright.cash.config.ts tests/cash-management/specs",
    "e2e:cash:ui": "playwright test --config playwright.cash.config.ts tests/cash-management/specs --ui",
    "e2e:cash:debug": "playwright test --config playwright.cash.config.ts tests/cash-management/specs --debug",
    "e2e:cash:local": "tsx scripts/cash-e2e-runner.ts",
    "e2e:cash:seed": "node scripts/cash-e2e-seed.js"
  },
  "devDependencies": {
    "@corely/contracts": "workspace:*",
    "@prisma/client": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "dotenv": "catalog:"
  },
  "author": "Ha Doan <ha@oneway8x.com>"
}
