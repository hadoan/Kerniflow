// CASH MANAGEMENT
// Subledger for tracking cash movements in registers

model CashRegister {
  id                      String   @id @default(cuid())
  tenantId                String
  workspaceId             String
  name                    String
  location                String?
  currency                String   @default("EUR") @db.VarChar(3)
  currentBalanceCents     Int      @default(0)
  disallowNegativeBalance Boolean  @default(false)
  createdAt               DateTime @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @db.Timestamptz(6)

  entries                CashEntry[]
  dayCloses              CashDayClose[]
  entryCounter           CashEntryCounter?
  exportArtifacts        CashExportArtifact[]
  confirmations          CashDayConfirmation[]
  workspaces             CashAssistantWorkspace[]
  cashWorkspaceHandoffs  CashWorkspaceHandoff[]
  cashEntryConfirmations CashEntryConfirmation[]

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([tenantId, workspaceId])
  @@index([tenantId, workspaceId, name])
  @@map("cash_registers")
  @@schema("accounting")
}

model CashEntry {
  id                 String   @id @default(cuid())
  tenantId           String
  workspaceId        String
  registerId         String
  entryNo            Int
  direction          String
  entryType          String
  source             String
  paymentMethod      String   @default("CASH")
  amountCents        Int
  grossAmountCents   Int
  netAmountCents     Int?
  taxAmountCents     Int?
  taxMode            String?
  taxCodeId          String?
  taxCode            String?
  taxRateBps         Int?
  taxLabel           String?
  currency           String   @default("EUR") @db.VarChar(3)
  description        String
  sourceDocumentId   String?
  sourceDocumentRef  String?
  sourceDocumentKind String?
  referenceId        String?
  occurredAt         DateTime @default(now()) @db.Timestamptz(6)
  dayKey             String
  balanceAfterCents  Int      @default(0)
  reversalOfEntryId  String?
  reversedByEntryId  String?  @unique
  lockedByDayCloseId String?
  idempotencyKey     String?

  // Legacy compatibility fields
  type         String
  sourceType   String
  businessDate String?

  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  createdByUserId String

  register      CashRegister          @relation(fields: [registerId], references: [id], onDelete: Cascade)
  lockedByClose CashDayClose?         @relation("CashDayCloseLockedEntries", fields: [lockedByDayCloseId], references: [id], onDelete: SetNull)
  closedDayCorrection CashDayCloseRevision? @relation("CashDayCloseRevisionEntry")
  attachments   CashEntryAttachment[]

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, workspaceId, registerId, entryNo])
  @@unique([tenantId, workspaceId, idempotencyKey])
  @@index([tenantId, workspaceId, registerId, dayKey, occurredAt])
  @@index([tenantId, workspaceId, registerId, occurredAt])
  @@index([tenantId, workspaceId, reversalOfEntryId])
  @@index([tenantId, workspaceId, lockedByDayCloseId])
  @@map("cash_entries")
  @@schema("accounting")
}

model CashDayClose {
  id                   String    @id @default(cuid())
  tenantId             String
  workspaceId          String
  registerId           String
  dayKey               String
  status               String    @default("DRAFT")
  expectedBalanceCents Int
  countedBalanceCents  Int?
  differenceCents      Int?
  verificationStatus   String    @default("NOT_COUNTED") // "NOT_COUNTED", "COUNTED_MATCH", "COUNTED_DIFFERENCE"
  note                 String?
  submittedAt          DateTime? @db.Timestamptz(6)
  submittedByUserId    String?
  lockedAt             DateTime? @db.Timestamptz(6)
  lockedByUserId       String?

  // Legacy compatibility fields
  businessDate   String
  notes          String?
  closedAt       DateTime? @db.Timestamptz(6)
  closedByUserId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  register      CashRegister            @relation(fields: [registerId], references: [id], onDelete: Cascade)
  entriesLocked CashEntry[]             @relation("CashDayCloseLockedEntries")
  countLines    CashDayCloseCountLine[]
  revisions     CashDayCloseRevision[]
  reviewRequirements CashDayCloseReviewRequirement[] @relation("AffectedCloseReviewRequirements")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, workspaceId, registerId, dayKey])
  @@index([tenantId, workspaceId, registerId, dayKey])
  @@index([tenantId, workspaceId, registerId, submittedAt])
  @@map("cash_day_closes")
  @@schema("accounting")
}

model CashDayCloseRevision {
  id                String   @id @default(cuid())
  tenantId          String
  workspaceId       String
  registerId        String
  dayCloseId        String
  correctionEntryId String   @unique
  revisionNo        Int
  correctionType    String
  reason            String
  occurredAt        DateTime @db.Timestamptz(6)
  recordedAt        DateTime @default(now()) @db.Timestamptz(6)
  createdByUserId   String
  originalSnapshot  Json
  correctedSnapshot Json
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  dayClose        CashDayClose @relation(fields: [dayCloseId], references: [id], onDelete: Restrict)
  correctionEntry CashEntry    @relation("CashDayCloseRevisionEntry", fields: [correctionEntryId], references: [id], onDelete: Restrict)
  reviewRequirements CashDayCloseReviewRequirement[]

  @@unique([dayCloseId, revisionNo])
  @@index([tenantId, workspaceId, registerId, dayCloseId])
  @@schema("accounting")
}

model CashDayCloseReviewRequirement {
  id                 String   @id @default(cuid())
  tenantId           String
  workspaceId        String
  revisionId         String
  affectedDayCloseId String
  status             String   @default("REVIEW_REQUIRED")
  reviewedAt         DateTime? @db.Timestamptz(6)
  reviewedByUserId   String?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  revision         CashDayCloseRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  affectedDayClose CashDayClose @relation("AffectedCloseReviewRequirements", fields: [affectedDayCloseId], references: [id], onDelete: Restrict)

  @@unique([revisionId, affectedDayCloseId])
  @@index([tenantId, workspaceId, affectedDayCloseId, status])
  @@schema("accounting")
}

model CashDayCloseCountLine {
  id                String   @id @default(cuid())
  tenantId          String
  workspaceId       String
  dayCloseId        String
  denominationCents Int
  count             Int
  subtotalCents     Int
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  dayClose CashDayClose @relation(fields: [dayCloseId], references: [id], onDelete: Cascade)

  @@unique([dayCloseId, denominationCents])
  @@index([tenantId, workspaceId, dayCloseId])
  @@map("cash_day_close_count_lines")
  @@schema("accounting")
}

model CashEntryAttachment {
  id               String   @id @default(cuid())
  tenantId         String
  workspaceId      String
  entryId          String
  documentId       String
  uploadedByUserId String?
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  entry CashEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([tenantId, workspaceId, entryId, documentId])
  @@index([tenantId, workspaceId, entryId])
  @@index([tenantId, workspaceId, documentId])
  @@map("cash_entry_attachments")
  @@schema("accounting")
}

model CashEntryCounter {
  id          String   @id @default(cuid())
  tenantId    String
  workspaceId String
  registerId  String   @unique
  lastEntryNo Int      @default(0)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  register CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, workspaceId, registerId])
  @@index([tenantId, workspaceId, registerId])
  @@map("cash_entry_counters")
  @@schema("accounting")
}

model CashExportArtifact {
  id              String    @id @default(cuid())
  tenantId        String
  workspaceId     String
  registerId      String
  month           String
  format          String
  fileName        String
  contentType     String
  contentBase64   String
  sizeBytes       Int
  createdByUserId String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt       DateTime? @db.Timestamptz(6)

  register CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@index([tenantId, workspaceId, registerId, month, format])
  @@index([tenantId, workspaceId, createdAt])
  @@map("cash_export_artifacts")
  @@schema("accounting")
}

model CashDayConfirmation {
  id               String @id @default(cuid())
  tenantId         String
  workspaceId      String
  registerId       String
  conversationId   String
  preparedByUserId String

  businessDate     String
  candidatePayload Json
  candidateHash    String
  version          Int    @default(1)

  status    String   @default("PENDING") // PENDING, CONFIRMED, CONSUMED, EXPIRED
  expiresAt DateTime @db.Timestamptz(6)

  confirmedAt DateTime? @db.Timestamptz(6)
  consumedAt  DateTime? @db.Timestamptz(6)
  consumedEntryId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  register  CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([tenantId, workspaceId, registerId])
  @@index([tenantId, workspaceId, conversationId])
  @@index([status, expiresAt])
  @@map("cash_day_confirmations")
  @@schema("accounting")
}

model CashAssistantWorkspace {
  id              String    @id @default(cuid())
  tenantId        String
  workspaceId     String
  registerId      String?
  locationId      String?
  type            String // DAILY_CASH_DAY, MONTHLY_REVIEW, GENERAL_HELP
  businessDate    DateTime? @db.Date
  businessMonth   DateTime? @db.Date
  conversationId  String    @unique
  cashDayId       String?
  createdByUserId String    @default("system")

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  register  CashRegister? @relation(fields: [registerId], references: [id], onDelete: Cascade)
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Unique indexes per type
  // Note: Prisma does not support partial unique indexes natively via @@unique with conditions.
  // We'll enforce this via standard unique index, but we need raw SQL to make it a partial index if we want it strictly in DB.
  // Or we just rely on the repository's getOrCreate constraint.
  // Actually, if we use a standard unique index with nullable fields, Postgres treats NULL != NULL, so it works.
  // But to be precise, we'll create the migration and inject partial unique indexes via SQL.
  @@unique([tenantId, locationId, registerId, businessDate, type], name: "daily_uniqueness", map: "cash_workspace_daily_idx")
  @@unique([tenantId, locationId, registerId, businessMonth, type], name: "monthly_uniqueness", map: "cash_workspace_monthly_idx")
  @@index([tenantId, workspaceId, conversationId])
  @@index([tenantId, workspaceId, type, businessDate])
  @@map("cash_assistant_workspaces")
  @@schema("accounting")
}

model CashWorkspaceHandoff {
  id         String  @id @default(cuid())
  tenantId   String
  locationId String?
  registerId String

  sourceWorkspaceId String
  targetWorkspaceId String

  sourceConversationId String
  sourceMessageId      String

  businessDate        String
  movementType        String
  amountCents         Int
  description         String
  evidenceRequirement String?

  candidateHash String
  version       Int    @default(1)

  confirmationId String?

  status String @default("PENDING") // PENDING, CONSUMED, CANCELLED, EXPIRED

  viewedAt       DateTime? @db.Timestamptz(6)
  viewedByUserId String?

  consumedAt  DateTime? @db.Timestamptz(6)
  cancelledAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceWorkspace Workspace    @relation("HandoffSource", fields: [sourceWorkspaceId], references: [id], onDelete: Cascade)
  targetWorkspace Workspace    @relation("HandoffTarget", fields: [targetWorkspaceId], references: [id], onDelete: Cascade)
  register        CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@index([tenantId, targetWorkspaceId])
  @@index([status, expiresAt])
  @@map("cash_workspace_handoffs")
  @@schema("accounting")
}

model CashEntryConfirmation {
  id               String  @id @default(cuid())
  tenantId         String
  workspaceId      String
  registerId       String
  conversationId   String?
  preparedByUserId String

  businessDate     String
  candidatePayload Json
  candidateHash    String
  version          Int    @default(1)

  status    String   @default("PENDING") // PENDING, CONFIRMED, CONSUMED, EXPIRED
  expiresAt DateTime @db.Timestamptz(6)

  confirmedAt DateTime? @db.Timestamptz(6)
  consumedAt  DateTime? @db.Timestamptz(6)
  consumedEntryId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  register  CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([tenantId, workspaceId, registerId])
  @@index([status, expiresAt])
  @@map("cash_entry_confirmations")
  @@schema("accounting")
}

model CashLocationTransfer {
  id              String   @id @default(cuid())
  tenantId        String
  workspaceId     String
  cashFundId      String
  fromLocationId  String
  toLocationId    String
  amountCents     Int
  occurredAt      DateTime @default(now()) @db.Timestamptz(6)
  businessDate    String
  createdByUserId String

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([tenantId, workspaceId, cashFundId, businessDate])
  @@map("cash_location_transfers")
  @@schema("accounting")
}

model CashMovementResolution {
  id             String    @id @default(cuid())
  tenantId       String
  workspaceId    String?
  registerId     String?
  conversationId String
  intent         String
  status         String
  extractionJson Json
  answerJson     Json?
  version        Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  consumedAt     DateTime?

  @@schema("accounting")
  @@index([tenantId, conversationId])
}
